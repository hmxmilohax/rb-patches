; fallbacks in case the config is outdated or broken
{set $dx_pad_slot kControllerVocals}
{set $dx_guitar_slot kControllerGuitar}
{set $dx_drum_slot kControllerDrum}
{set $emulatefps 30}
{set $mvemulatefps 60}
{set $dx_vsync TRUE}
{set $trackspeed 1.0}

INIT_DTA_READER

{set $dxsettings {load_objects #ifdef HX_XBOX "GAME:/config.milo" #else "GD:/dev_hdd0/game/BLUS30147/USRDIR/config.milo" #endif}}
{if_else $dxsettings
   {do
      LOAD_DX_SETTINGS
      {delete $dxsettings}
   }
   {do
      SAVE_DX_SETTINGS
   }
}

{rnd set_sync $dx_vsync}