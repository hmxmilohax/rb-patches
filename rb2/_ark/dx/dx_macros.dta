#define INIT_DTA_READER
(
   {set $dxsettings {read_file #ifdef HX_XBOX "GAME:/config.dta" #endif #ifdef HX_PS3 "GD:/dev_hdd0/game/BLUS30147/USRDIR/config.dta" #endif}}
   {foreach $entry $dxsettings
      {if {== {elem $entry 0} {basename track_speed}}
         {set $trackspeed
            {elem {find $entry track_speed} 1}
         }
      }
      {if {== {elem $entry 0} {basename sync_diff_speeds}}
         {set $dx_sync_diff_speeds
            {elem {find $entry sync_diff_speeds} 1}
         }
      }
      {if {== {elem $entry 0} {basename venue_fps}}
         {set $emulatefps
            {elem {find $entry venue_fps} 1}
         }
      }
      {if {== {elem $entry 0} {basename video_venue_fps}}
         {set $mvemulatefps
            {elem {find $entry video_venue_fps} 1}
         }
      }
      #ifdef HX_PS3
      {if {== {elem $entry 0} {basename vsync}}
         {set $dx_vsync
            {elem {find $entry vsync} 1}
         }
      }
      #endif
      {if {== {elem $entry 0} {basename pad_slot}}
         {set $dx_pad_slot
            {elem {find $entry pad_slot} 1}
         }
      }
      {if {== {elem $entry 0} {basename guitar_slot}}
         {set $dx_guitar_slot
            {elem {find $entry guitar_slot} 1}
         }
      }
      {if {== {elem $entry 0} {basename drum_slot}}
         {set $dx_drum_slot
            {elem {find $entry drum_slot} 1}
         }
      }
   }
)

#define LOAD_DX_SETTINGS
(
   {if {$dxsettings get mod_nofail} {modifier_mgr activate_modifier mod_nofail}}
   {if {$dxsettings get mod_doublespeed} {modifier_mgr activate_modifier mod_doublespeed}}
   {if {$dxsettings get mod_choose_venue} {modifier_mgr activate_modifier mod_choose_venue}}
   {if {$dxsettings get mod_newvenuesonly} {modifier_mgr activate_modifier mod_newvenuesonly}}
   {if {$dxsettings get mod_awesome} {modifier_mgr activate_modifier mod_awesome}}
)

#define SAVE_DX_SETTINGS
(
   {new ObjectDir dxsettings}
   {dxsettings set mod_nofail {modifier_mgr is_modifier_active mod_nofail}}
   {dxsettings set mod_doublespeed {modifier_mgr is_modifier_active mod_doublespeed}}
   {dxsettings set mod_choose_venue {modifier_mgr is_modifier_active mod_choose_venue}}
   {dxsettings set mod_newvenuesonly {modifier_mgr is_modifier_active mod_newvenuesonly}}
   {dxsettings set mod_awesome {modifier_mgr is_modifier_active mod_awesome}}
   {dxsettings save_objects #ifdef HX_XBOX "GAME:/config.milo" #else "GD:/dev_hdd0/game/BLUS30147/USRDIR/config.milo" #endif}
)

#define DX_FPS_SETUP
(
   {$world iterate PostProc $p {unless {== $p "photocopy.pp"} {$p set emulate_fps {if_else {in_video_venue} $mvemulatefps $emulatefps}}}}
)
